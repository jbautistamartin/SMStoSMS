<?xml version="1.0" encoding="utf-8"?>
<!--
    Fondo del icono adaptativo.

    Verde azulado, el color primario de la aplicación (`md_theme_primary`), en lugar del azul
    #1565C0 que venía de SMSGateway: las dos aplicaciones pueden convivir en el mismo teléfono
    y tienen que distinguirse de un vistazo en el lanzador.

    El degradado es sutil a propósito. A 48 dp no se percibe como degradado, solo evita que el
    icono se vea plano junto a los demás.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#00828F"
                android:endColor="#00424B" />
        </aapt:attr>
    </path>

</vector>
